{
  "author": "Franco N. Colaizzi",
  "customElements": "./custom-elements.json",
  "description": "Design tokens for fnc314.github.io, managed by Style Dictionary.",
  "dependencies": {
    "lit": "catalog:dependencies",
    "@material/web": "catalog:dependencies",
    "material-symbols": "catalog:dependencies"
  },
  "peerDependencies": {
    "@fnc314/packages.types": "workspace:*"
  },
  "devDependencies": {
    "@fnc314/configs.postcss": "workspace:*",
    "@fnc314/configs.typescript": "workspace:*",
    "@types/fs-extra": "catalog:devDependencies",
    "fs-extra": "catalog:devDependencies",
    "style-dictionary": "catalog:devDependencies",
    "typescript": "catalog:typescript",
    "typescript7": "catalog:typescript",
    "postcss-lit": "catalog:devDependencies",
    "unplugin-dts": "catalog:devDependencies",
    "unplugin-info": "catalog:devDependencies",
    "vite": "catalog:devDependencies"
  },
  "engines": {
    "node": "26.8.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.0.0+sha512.9e2e3dc3911995868dc94b8175c217c27e95408fa03b4a22749778f2b34f773b77cdd3b39ede8171b22fcd53be6a35342e9fac9948a68ef58df6488ce89a7e67",
      "onFail": "warn"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "style": "./dist/@fnc314.packages.design-tokens.css",
      "import": "./dist/@fnc314.packages.design-tokens.js",
      "default": "./dist/@fnc314.packages.design-tokens.js"
    },
    "./css/*": {
      "default": "./dist/@fnc314.packages.design-tokens.css",
      "style": "./dist/css/*"
    },
    "./dist/*": "./dist/*",
    "./icons/*": "./dist/icons/*",
    "./json/*": "./dist/json/*",
    "./index.css": {
      "default": "./dist/@fnc314.packages.design-tokens.css",
      "style": "./dist/@fnc314.packages.design-tokens.css"
    },
    "./styles.css": {
      "default": "./dist/@fnc314.packages.design-tokens.css",
      "style": "./dist/@fnc314.packages.design-tokens.css"
    },
    "./themes/*": "./dist/themes/*",
    "./types/*": "./dist/types/*",
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "./dist/@fnc314.packages.design-tokens.css",
    "./dist/@fnc314.packages.design-tokens.js",
    "./dist/icons",
    "./dist/types/**/*.d.ts",
    "./dist/themes/**/*.{jpg,json}",
    "./dist/css/*.css",
    "./dist/json/*.json"
  ],
  "keywords": [
    "design-tokens",
    "style-dictionary"
  ],
  "license": "ISC",
  "main": "./dist/@fnc314.packages.design-tokens.js",
  "module": "./dist/@fnc314.packages.design-tokens.js",
  "name": "@fnc314/packages.design-tokens",
  "packageManager": "pnpm@12.0.0+sha512.9e2e3dc3911995868dc94b8175c217c27e95408fa03b4a22749778f2b34f773b77cdd3b39ede8171b22fcd53be6a35342e9fac9948a68ef58df6488ce89a7e67",
  "private": true,
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "version": "3.5.0"
}
